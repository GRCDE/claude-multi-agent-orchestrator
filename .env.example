# Server
PORT=3131
NODE_ENV=development

# Agent-Konfiguration
AGENT_TIMEOUT=300000
MAX_RETRIES=5
RETRY_BASE_DELAY=5000
MAX_AGENTS=10
AGENT_CONCURRENCY=3
MAX_ROUNDS=5
AUTO_RETRY=true

# Workspace-Isolation für Agenten
# 'shared' (Standard): Agenten arbeiten in eigenen Unterverzeichnissen,
#   können aber Dateien anderer Agenten sehen und gemeinsamen Kontext nutzen.
# 'strict': Agenten können NUR auf ihr eigenes Verzeichnis zugreifen.
#   Gemeinsamer Kontext und Dateipfade anderer Agenten werden nicht geteilt.
AGENT_ISOLATION=shared

# Claude-Ausfuehrungsmodus
# 'cli' (Standard): Startet Claude als CLI-Prozess (claude --dangerously-skip-permissions -p "...")
# 'sdk': Nutzt die native @anthropic-ai/claude-code SDK (muss installiert sein: npm install @anthropic-ai/claude-code)
#   Vorteile: Bessere Performance, strukturierte Token-Usage, kein Prozess-Spawning
# 'auto': Versucht zuerst SDK, faellt automatisch auf CLI zurueck wenn SDK nicht verfuegbar
CLAUDE_MODE=cli

# Git-Integration
# Wenn aktiviert, werden Projekt-Ergebnisse automatisch in ein Git-Repository committed.
GIT_ENABLED=false
# Absoluter Pfad zum Ziel-Git-Repository
# GIT_WORK_DIR=/pfad/zum/repo
# Auto-Commit nach jedem erfolgreichen Merge (Standard: true)
GIT_AUTO_COMMIT=true
# Eigener Branch pro Projekt (Standard: true)
GIT_BRANCH_PER_PROJECT=true
# Automatisch zum Remote pushen nach Commit (Standard: false)
GIT_AUTO_PUSH=false
# Prefix fuer Commit-Messages (Standard: [orchestrator])
GIT_COMMIT_PREFIX=[orchestrator]

# Webhook-Benachrichtigungen (optional)
# Wenn gesetzt, sendet der Orchestrator POST-Requests bei wichtigen Events:
#   - project_started:   Projekt wurde geplant und Agenten starten
#   - project_completed: Alle Agenten sind fertig
#   - agent_error:       Ein Agent ist fehlgeschlagen
# Zum Testen: node webhook-test.js starten und diese URL setzen:
# WEBHOOK_URL=http://localhost:3132

# API-Authentifizierung (optional)
# Wenn gesetzt, benötigen alle POST/DELETE-Endpoints einen
# Authorization: Bearer <token> Header. GET-Endpoints bleiben offen.
# Ohne API_TOKEN funktioniert alles ohne Authentifizierung (abwärtskompatibel).
# API_TOKEN=mein-geheimer-token-hier

# Prompt-Templates (optional)
# Pfad zu einer benutzerdefinierten Prompt-Datei (JSON).
# Wenn nicht gesetzt, wird zuerst prompts.json gesucht, dann prompts.default.json,
# dann eingebaute Defaults verwendet.
# PROMPTS_FILE=prompts.json

# Logging
LOG_LEVEL=info
